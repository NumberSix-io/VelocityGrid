<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NuspecFile>VelocityGrid.Wpf.nuspec</NuspecFile>
    <VelocityGridPackageVersion Condition="'$(VelocityGridPackageVersion)' == ''">0.1.0-preview.1</VelocityGridPackageVersion><NuspecProperties>version=$(VelocityGridPackageVersion)</NuspecProperties>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\packages</PackageOutputPath>
  </PropertyGroup>
  <Target Name="ValidateVelocityGridWpfPackageInputs" BeforeTargets="Pack">
    <Error Condition="!Exists('..\VelocityGrid.Wpf\bin\x64\Release\net8.0-windows10.0.19041.0\VelocityGrid.Wpf.dll')"
           Text="Build VelocityGrid.Wpf Release x64 before packing." />
  </Target>
</Project>
