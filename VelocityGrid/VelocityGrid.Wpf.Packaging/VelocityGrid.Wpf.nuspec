<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>VelocityGrid.Wpf</id>
    <version>$version$</version>
    <title>VelocityGrid WPF Host</title>
    <authors>Dean Chalk</authors>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/NumberSix-io/VelocityGrid</projectUrl>
    <copyright>Copyright (c) 2026 Dean Chalk</copyright>
    <releaseNotes>https://github.com/NumberSix-io/VelocityGrid/blob/main/CHANGELOG.md</releaseNotes>
    <repository type="git" url="https://github.com/NumberSix-io/VelocityGrid.git" />
    <readme>README.md</readme>
    <description>A frictionless WPF HwndHost adapter for the native WinUI VelocityGrid control.</description>
    <tags>wpf winui xaml-islands datagrid virtualization</tags>
    <dependencies>
      <group targetFramework="net8.0-windows10.0.19041.0">
        <dependency id="VelocityGrid.WinUI" version="[$version$]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\VelocityGrid.Wpf\bin\x64\Release\net8.0-windows10.0.19041.0\VelocityGrid.Wpf.dll" target="lib\net8.0-windows10.0.19041.0" />
    <file src="..\VelocityGrid.Wpf\bin\x64\Release\net8.0-windows10.0.19041.0\VelocityGrid.Wpf.pdb" target="lib\net8.0-windows10.0.19041.0" />
    <file src="..\VelocityGrid.Wpf\bin\x64\Release\net8.0-windows10.0.19041.0\VelocityGrid.Wpf.xml" target="lib\net8.0-windows10.0.19041.0" />
    <file src="buildTransitive\VelocityGrid.Wpf.props" target="buildTransitive\VelocityGrid.Wpf.props" />
    <file src="..\..\NUGET_README.md" target="README.md" />
    <file src="..\..\LICENSE" />
  </files>
</package>
